# Copia este archivo como .env en la raíz del proyecto y ajusta los valores.
# El archivo .env nunca debe subirse al repositorio.

APP_NAME=CapaFiscal
# production: al arrancar se comprueba la configuración (python -m app.production) y no arranca si hay algo inseguro
APP_ENVIRONMENT=development
DEBUG=false
# Solo demostraciones (en producción impiden arrancar): datos y conectores de ejemplo, y borrar todo al arrancar.
# APP_MODE=real
# SEED_DEMO_DATA=false
# ENABLE_DEMO_CONNECTORS=false
# RESET_DATA_ON_STARTUP=false
# Registros: LOG_FORMAT=json para un recolector; LOG_LEVEL=INFO|WARNING
LOG_FORMAT=text
LOG_LEVEL=INFO
# Firma de los enlaces de «He olvidado mi contraseña» (python -c "import secrets; print(secrets.token_urlsafe(48))").
# Sin ella se genera una en DATA_DIR; con varias instancias, la misma en todas.
APP_SECRET_KEY=

# Base de datos. Por defecto SQLite en backend/data/capafiscal.db.
# Para PostgreSQL: postgresql+psycopg://usuario:clave@host:5432/capafiscal
# DATABASE_URL=sqlite:///backend/data/capafiscal.db
# Producción: PostgreSQL (docker-compose.yml lo levanta y fija DATABASE_URL solo).
# DATABASE_URL=postgresql+psycopg://capafiscal:CONTRASEÑA@localhost:5432/capafiscal
# POSTGRES_PASSWORD=cámbiala

# Carpetas de datos y documentos (por defecto backend/data y backend/uploads).
# DATA_DIR=backend/data
# UPLOAD_DIR=backend/uploads

MAX_UPLOAD_SIZE=15728640
ALLOWED_EXTENSIONS=.pdf,.txt

# Tu empresa. Ayuda a distinguir cliente (tú) y proveedor en las facturas.
# Admite varios NIF separados por comas.
COMPANY_NAME=
COMPANY_TAX_IDS=

# Tolerancia de cuadre de importes (euros) y confianza mínima para
# proponer aprobación directa.
AMOUNT_TOLERANCE=0.02
MINIMUM_AUTO_CONFIDENCE=80

# --- Conector de Outlook (Microsoft Graph) -------------------------------
# Registra una aplicación en Microsoft Entra ID con permisos delegados
# User.Read y Mail.Read, y como URI de redirección la indicada abajo.
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=common
OUTLOOK_REDIRECT_URI=http://127.0.0.1:8000/api/connectors/outlook/callback

# Clave para cifrar la sesión de Outlook en disco. Genérala con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# --- Envío de correo (bandeja de salida) ---------------------------------
# Sin SMTP, cada mensaje se descarga como borrador .eml (Outlook/Thunderbird
# lo abren listo para enviar). Con SMTP, se envía desde la aplicación.
# Fuera de producción (APP_ENVIRONMENT≠production) SOLO se entrega a un buzón local:
#   docker compose --profile dev up   →  SMTP_HOST=mailpit, SMTP_PORT=1025 (correos en http://127.0.0.1:8025)
#   sin Docker: Mailpit en este equipo →  SMTP_HOST=localhost, SMTP_PORT=1025
#   (localhost, 127.0.0.1, ::1, mailpit y mailhog se tratan SIEMPRE como buzón de pruebas: si en localhost
#    hay un relé de correo real, el correo saldría; no apuntes SMTP_HOST a un relé real en desarrollo)
# Producción, ejemplo Office 365: smtp.office365.com, puerto 587, STARTTLS (siempre TLS con un servidor real).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false
# true solo para probar en desarrollo contra un servidor real (enviaría correos de verdad)
SMTP_ALLOW_EXTERNAL=false

# --- Correo entrante (conector de correo) ---------------------------------
# Buzón IMAP del que se leen facturas y notificaciones (cada 5 minutos).
# Sin IMAP, deja los .eml en data/buzon o impórtalos desde Expedientes.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_USE_SSL=true

# Docker en producción (docker-compose.prod.yml): dominio público con su DNS apuntando al servidor.
# Caddy obtiene el certificado HTTPS solo. DOMAIN=localhost sirve para probar la cadena en local.
# DOMAIN=capafiscal.tuempresa.es

# Automatizaciones programadas (conciliación, recurrentes, reclamaciones,
# resumen diario, borrador de nómina, cierre para la gestoría).
ENABLE_SCHEDULER=true

# --- Agentes con IA (opcional) -------------------------------------------
# Sin clave, los agentes trabajan con reglas y plantillas deterministas.
# Con clave, Claude lee las notificaciones (qué piden, periodos, acciones) y
# redacta los escritos; cada paso guarda qué motor participó.
# La clave va en el entorno o en .env (nunca en el código ni en el repositorio). Gasto: pon un límite en la consola.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5

# Dirección pública de la aplicación para los enlaces de subida de
# documentos que el Perseguidor envía (portal sin usuario).
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Multiempresa (gestoría → clientes): usuarios, roles y aislamiento estricto por cliente
AUTH_REQUIRED=false
SESSION_HOURS=12

# Carpeta con notificaciones descargadas de la DEHú (PDF + .json de metadatos)
DEHU_INBOX_DIR=

# INTEL_WINDOW_DAYS=30   # días de publicaciones del BOE que se miran en cada radar
# Inteligencia (radar jurídico del BOE). Si el servidor no puede salir a www.boe.es,
# apunta a una carpeta con los sumarios (AAAAMMDD.json) y fichas (BOE-A-….xml) descargados.
# INTEL_BOE_FOLDER=/ruta/a/boe

# Banco conectado (PSD2) a través de un agregador con licencia (API de GoCardless Bank Account Data).
# Necesita las credenciales del agregador, salida a internet hacia su API y que el titular autorice el
# acceso en la web de su banco (el consentimiento dura 90 días). Sin esto, se importa el extracto CSV/Excel.
# BANK_DATA_SECRET_ID=
# BANK_DATA_SECRET_KEY=
# BANK_DATA_URL=https://bankaccountdata.gocardless.com/api/v2
# Respuestas guardadas del agregador (pruebas y demostraciones sin red):
# BANK_DATA_FOLDER=backend/tests/fixtures/bank

# Copias de seguridad (python -m app.backup create). Guárdalas fuera del servidor.
# BACKUP_PASSPHRASE=          # cifra las copias; sin ella no se pueden leer ni restaurar
# BACKUP_DIR=/ruta/copias
# BACKUP_KEEP=14
